
FROM eclipse-temurin:21-jdk-alpine

WORKDIR /app

COPY gradlew settings.gradle.kts build.gradle.kts gradle.properties ./
COPY gradle ./gradle
COPY src ./src

RUN chmod +x gradlew && \
    ./gradlew --no-daemon shadowJar && \
    find build/libs -name '*-all.jar' -print -quit | grep -q .

RUN JAR=$(find build/libs -name '*-all.jar' -print -quit) && \
    cp "$JAR" /app/vusan.jar

RUN apk add --no-cache deno ffmpeg python3 py3-pip && \
    pip install --pre --no-cache-dir --break-system-packages "yt-dlp[default]"

CMD ["java", "-jar", "vusan.jar"]
